# OSINT Workbench example configuration - placeholders only.
DATABASE_URL=postgresql+psycopg://osint:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/osint
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/REPLACE_WITH_NEO4J_PASSWORD

# Required only for DOMAIN ACTIVE scans. Generate a random value locally.
# Example command: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OSINT_ACTIVE_TOKEN=REPLACE_WITH_RANDOM_ACTIVE_TOKEN
